# ============================================================================
# AI Service — environment configuration
# Copy to .env and fill in values. Never commit .env.
# ============================================================================

# --- Runtime ---
APP_NAME=ai-service
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
APP_VERSION=0.1.0

# --- Server ---
HOST=0.0.0.0
PORT=8000
# Comma-separated origins for CORS. Use "*" only in development.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- LLM providers (placeholders — wire in a follow-up change) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEFAULT_MODEL=gpt-4o-mini

# ============================================================================
# Neo4j (graph database)
# Get these from Neo4j Aura: https://console.neo4j.io
# Connection string format: neo4j+s://xxxxx.databases.neo4j.io
# ============================================================================
NEO4J_URL=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Pool sizing — tune based on worker count and query load.
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT_SEC=10

# --- Safety ---
# Required for any DESTRUCTIVE Neo4j operation (e.g. reset_graph).
# Must be unset or false in production. Reset calls will raise without it.
NEO4J_ALLOW_DESTRUCTIVE=false

# ============================================================================
# Node-backend (the only data source the ai-service talks to)
# All tool queries go through this API. The ai-service never connects to
# Postgres directly.
# ============================================================================
NODE_BACKEND_URL=http://localhost:3000
NODE_BACKEND_SERVICE_TOKEN=replace-me-shared-secret-with-node-backend
NODE_BACKEND_TIMEOUT_SEC=30

# ============================================================================
# LLM providers
# The agent supports two providers — pick one with LLM_PROVIDER.
# ============================================================================
# Provider: "groq" or "minimax"
LLM_PROVIDER=groq

# --- Groq ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- MiniMax (MiniMax) ---
# MiniMax exposes an OpenAI-compatible API. Set the base URL to the
# provider's OpenAI-compatible endpoint, and use a MiniMax model name.
MINIMAX_API_KEY=
# MiniMax public API endpoint (OpenAI-compatible) — confirm the exact URL
# with MiniMax before going to production.
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-Text-01

# Max agent steps (prevents runaway loops). Default 8.
AGENT_MAX_STEPS=8
