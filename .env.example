# Models
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# CORS — comma-separated frontend origins (dev default: http://localhost:5173)
CORS_ORIGINS=["http://localhost:5173"]

# Service auth (must match NODE_INTERNAL_SECRET in node-backend)
INTERNAL_SECRET=

# Node.js API
NODE_API_URL=http://localhost:4000
BOT_SECRET=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Limits (optional — defaults shown)
MAX_HISTORY_TURNS=10
MAX_TOKENS_PER_REQUEST=5000
GROQ_RATE_LIMIT_RPM=28
